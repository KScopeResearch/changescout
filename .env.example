# PJ2 AOR — Lead管理パイプライン（scripts/generator/leads/）関連の環境変数テンプレート。
#
# 【重要】このファイルにAWS Access Key / Secret Access Key等の実際の値を書かないこと。
# 値は実行環境（ローカルシェル、CI Secrets、Lambda環境変数、AWS CLI named profile等）から
# 供給する。本ファイルはキー名を示すテンプレートであり、そのまま`.env`にリネームして
# 値を埋めて使う運用も想定していない（プロジェクトには`.env`読み込み処理が無いため）。
#
# 詳細はscripts/generator/README.md「Leadライフサイクル管理とS3バックエンド」参照。

# ---------------------------------------------------------------------------
# Lead保存先バックエンド（lead-store.js）
# ---------------------------------------------------------------------------

# 未設定時の既定値は "filesystem"（scripts/generator/logs/leads/配下にJSON保存）。
# S3を使う場合のみ "s3" を指定する。
LEAD_STORE_BACKEND=s3

# LEAD_STORE_BACKEND=s3 のとき必須。
LEAD_STORE_S3_BUCKET=

# LEAD_STORE_BACKEND=s3 のとき任意（既定値 "leads/"）。
LEAD_STORE_S3_PREFIX=leads/

# S3・SESの両方で共通利用するリージョン（s3-backend.js・ses-client.js）。
AWS_REGION=ap-northeast-1

# ---------------------------------------------------------------------------
# 公開状態の保存先バックエンド（published-store.js、PJ2 AOR Phase 3-D-1）
# ---------------------------------------------------------------------------

# website/aor/data/<slug>.jsonの存在で表していた「公開済みかどうか」の判定を、
# Lambda等のローカルファイルシステムに依存できない実行環境からも行えるようにするための設定。
# 未設定時の既定値は "filesystem"（従来通りwebsite/aor/data/<slug>.jsonの存在確認のみ）。
# ローカルのwebsite/aor/data/への書き込み・削除（deploy-aor-web.jsの同期元）は、
# この設定に関わらず常に行われる。s3を指定した場合のみ、Lambda側の公開判定に使う
# canonical stateとして追加でS3オブジェクトへも保存する。
PUBLISHED_STORE_BACKEND=s3

# PUBLISHED_STORE_BACKEND=s3 のとき必須。
PUBLISHED_STORE_S3_BUCKET=

# PUBLISHED_STORE_BACKEND=s3 のとき任意（既定値 "published/"）。
PUBLISHED_STORE_S3_PREFIX=published/

# ---------------------------------------------------------------------------
# AWS認証情報（任意 — 未設定時はAWS SDKの既定クレデンシャルチェーンに委ねる）
# ---------------------------------------------------------------------------

# S3バックエンド（@aws-sdk/client-s3使用）・SES送信（ses-client.js、PJ2次工程で
# @aws-sdk/credential-provider-nodeのcredential provider chainへ移行済み）とも、
# 未設定でもnamed profile（IAM Identity Center SSO含む）・IAMロール等の既定クレデンシャル
# チェーンから解決できる。この3変数を明示設定した場合はチェーンの中で最優先される
# （長期アクセスキーによる運用も引き続き利用可能）。
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ---------------------------------------------------------------------------
# SES送信（scripts/generator/leads/send-initial-report.js・ses-client.js）
# ---------------------------------------------------------------------------

# 送信元アドレス（SESで検証済みIdentityである必要がある）。
SES_FROM=

# 返信先アドレス（任意）。
SES_REPLY_TO=

# report-preview.htmlの配置先ベースURL（send-initial-report.jsが本文中のリンク生成に使用）。
AOR_SITE_BASE_URL=
