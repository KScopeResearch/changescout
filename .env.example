# PJ2 AOP — Lead管理パイプライン（scripts/generator/leads/）関連の環境変数テンプレート。
#
# 【重要】このファイルにAWS Access Key / Secret Access Key等の実際の値を書かないこと。
# 値は実行環境（ローカルシェル、CI Secrets、Lambda環境変数、AWS CLI named profile等）から
# 供給する。本ファイルはキー名を示すテンプレートであり、そのまま`.env`にリネームして
# 値を埋めて使う運用も想定していない（プロジェクトには`.env`読み込み処理が無いため）。
#
# 詳細はscripts/generator/README.md「Leadライフサイクル管理とS3バックエンド」参照。

# ---------------------------------------------------------------------------
# Lead保存先バックエンド（lead-store.js）
# ---------------------------------------------------------------------------

# 未設定時の既定値は "filesystem"（scripts/generator/logs/leads/配下にJSON保存）。
# S3を使う場合のみ "s3" を指定する。
LEAD_STORE_BACKEND=s3

# LEAD_STORE_BACKEND=s3 のとき必須。
LEAD_STORE_S3_BUCKET=

# LEAD_STORE_BACKEND=s3 のとき任意（既定値 "leads/"）。
LEAD_STORE_S3_PREFIX=leads/

# S3・SESの両方で共通利用するリージョン（s3-backend.js・ses-client.js）。
AWS_REGION=ap-northeast-1

# ---------------------------------------------------------------------------
# AWS認証情報（任意 — 未設定時はAWS SDKの既定クレデンシャルチェーンに委ねる）
# ---------------------------------------------------------------------------

# S3バックエンド（@aws-sdk/client-s3使用）は、未設定でもnamed profile・IAMロール等の
# 既定クレデンシャルチェーンから解決できる。
# 一方、SES送信（ses-client.js、自前SigV4実装）はこの3変数（SESSION_TOKENは任意）を
# 直接読むため、SES送信を行う場合はAWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEYの設定が必須。
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ---------------------------------------------------------------------------
# SES送信（scripts/generator/leads/send-initial-report.js・ses-client.js）
# ---------------------------------------------------------------------------

# 送信元アドレス（SESで検証済みIdentityである必要がある）。
SES_FROM=

# 返信先アドレス（任意）。
SES_REPLY_TO=

# report-preview.htmlの配置先ベースURL（send-initial-report.jsが本文中のリンク生成に使用）。
AOR_SITE_BASE_URL=
